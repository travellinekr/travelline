# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# docs (워크스루 등 로컬 문서)
/doc/
package-lock.json

# claude agent 로컬 생성 파일
/.agent/
/.claude/

# 임시 작업 폴더(참조 데이터 수집 원본 등)
/tmp/
android/travelline-release.jks
android/keystore.properties
*.jks
*.keystore

# Xcode SPM 로컬 캐시
ios/**/xcshareddata/swiftpm/

# 프로모션 영상 작업 폴더(로컬 전용 · node_modules/대용량 에셋 포함)
/promotion-video/

# Places 마이그레이션 작업 리포트(로컬 전용 산출물)
/.scratchpad/

# 코드/데이터 불일치 점검 메모(로컬 전용)
/코드불일치.md
